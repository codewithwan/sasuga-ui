{
  "name": "sasuga-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo of sasuga/ui — game-feel UI components: the docs site, the framework packages (React today, Vue planned), the registry and the CLI.",
  "license": "MIT",
  "author": "codewithwan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codewithwan/sasuga-ui.git"
  },
  "homepage": "https://codewithwan.github.io/sasuga-ui/",
  "bugs": {
    "url": "https://github.com/codewithwan/sasuga-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "game-ui",
    "anime",
    "animation",
    "springs",
    "shadcn",
    "vue"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev": "npm run dev -w @sasuga/docs --",
    "build": "npm run build -w @sasuga/docs",
    "preview": "npm run preview -w @sasuga/docs --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "registry:build": "node scripts/build-registry.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "icons": "bash scripts/build-icons.sh"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2"
  }
}
